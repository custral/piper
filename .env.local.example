# ─────────────────────────────────────────────────────────────────────────────
# Custral Usage SDK — server-side only (never sent to the browser).
# Tracks compression events against your Custral Usage Module.
# ─────────────────────────────────────────────────────────────────────────────

CUSTRAL_PUBLISHABLE_KEY=pk_xxx
CUSTRAL_MODULE_ID=umod_xxx

# Pre-create one product record per metered feature and paste its record id here.
CUSTRAL_PRODUCT_COMPRESS_ID=rec_xxx

# Optional — defaults to https://api.custral.com (server-side usage calls).
# CUSTRAL_API_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Live Custral chat widget — exposed to the browser (a publishable key is safe
# to ship client-side). Powers the floating chat bubble + in-chat scheduling.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_CUSTRAL_PUBLISHABLE_KEY=pk_xxx
# Optional — pin a specific widget channel; defaults to the org's first widget channel.
# NEXT_PUBLIC_CUSTRAL_CHANNEL_ID=chan_xxx
# Optional — defaults to https://api.custral.com
# NEXT_PUBLIC_CUSTRAL_API_BASE_URL=http://localhost:3000
